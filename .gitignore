# Go defaults (from github/gitignore Go template)
# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary
*.test

# Coverage / test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependencies (uncomment to include)
# vendor/

# Go workspace
go.work
go.work.sum

# Env file
.env

# Editor / IDE
# .idea/
.vscode/
.DS_Store

# zebracode runtime data (local, do NOT commit)
# config.yaml holds API keys; sessions/memory/file-history hold
# conversations, file snapshots and private info. Some were already
# tracked — run `git rm --cached <path>` to untrack.
.zebracode/config.yaml
.zebracode/permissions.local.yaml
.zebracode/prompt_history.jsonl
.zebracode/sessions
.zebracode/file-history
.zebracode/memory
.zebracode/tasks
.zebracode/plans
.zebracode/skills
# To keep a specific local skill, add: !.zebracode/skills/<name>

# Keep the config template tracked
!.zebracode/config.yaml.example

# WorkBuddy internal state (private, do NOT commit)
.workbuddy/

# Go build artifact (binary at repo root)
/zebracode

# Local personal docs (not pushed, do NOT commit)
docs/personal/
